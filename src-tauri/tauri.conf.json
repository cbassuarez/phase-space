{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "phase-space",
  "version": "1.1.1",
  "identifier": "io.github.cbassuarez.phasespace",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix web run dev:app -- --port 1420 --strictPort",
    "beforeBuildCommand": "npm --prefix web run build:app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "phase-space",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg-background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 480, "y": 190 }
      }
    }
  }
}
